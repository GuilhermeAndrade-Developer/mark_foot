# Database Configuration
DB_HOST=mysql_db
DB_PORT=3306
DB_NAME=mark_foot_db_dev
DB_USER=mark_foot_user
DB_PASSWORD=mark_foot_password

# Football Data API
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# Django Configuration
SECRET_KEY=django-insecure-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Rate Limiting
FOOTBALL_DATA_RATE_LIMIT=10

# Payment Gateway Configuration
# Stripe (Test/Development) - Get your keys from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# PagSeguro (Sandbox/Development) - Get from PagSeguro Developer Portal
PAGSEGURO_EMAIL=your_sandbox_email@example.com
PAGSEGURO_TOKEN=YOUR_PAGSEGURO_SANDBOX_TOKEN_HERE
PAGSEGURO_SANDBOX=True

# Mercado Pago (Test/Development) - Get from Mercado Pago Developer Portal
MERCADOPAGO_ACCESS_TOKEN=TEST-YOUR_MERCADOPAGO_TOKEN_HERE
MERCADOPAGO_SANDBOX=True

# WhatsApp Business API (Get from Meta Business)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_ID=your_phone_id
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_VERIFY_TOKEN=your_verify_token

# Redis Configuration
REDIS_URL=redis://redis_dev:6379/0

# Email Configuration (Development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Logging
LOG_LEVEL=INFO

# API Sports (RapidAPI) - For future implementation
# RAPIDAPI_KEY=your_key_here
# RAPIDAPI_HOST=api-football-v1.p.rapidapi.com
