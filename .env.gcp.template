# ============================================================================
# MARK FOOT - GCP DEPLOYMENT CONFIGURATION
# ============================================================================
# Environment variables for Google Cloud Platform deployment
# Copy this to .env.prod and configure your GCP resources

# ============================================================================
# BASIC APPLICATION SETTINGS
# ============================================================================
DEBUG=False
DJANGO_SETTINGS_MODULE=mark_foot_backend.settings
SECRET_KEY=your-super-secret-production-key-here-min-50-chars

# ============================================================================
# FRONTEND/BACKEND URLS
# ============================================================================
FRONTEND_URL=https://app.markfoot.com
BACKEND_URL=https://api.markfoot.com
ALLOWED_HOSTS=api.markfoot.com,app.markfoot.com,*.run.app

# ============================================================================
# GCP CLOUD SQL DATABASE CONFIGURATION
# ============================================================================
DB_HOST=/cloudsql/your-project-id:us-central1:mark-foot-db
DB_PORT=3306
DB_NAME=mark_foot_prod
DB_USER=mark_foot_admin
DB_PASSWORD=your-secure-db-password

# For Cloud SQL Proxy connection
GOOGLE_CLOUD_PROJECT=your-project-id
CLOUD_SQL_CONNECTION_NAME=your-project-id:us-central1:mark-foot-db

# ============================================================================
# GCP CLOUD STORAGE CONFIGURATION
# ============================================================================
GS_BUCKET_NAME=mark-foot-media-prod
GS_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-key.json
GS_DEFAULT_ACL=publicRead

# ============================================================================
# GCP CLOUD RUN CONFIGURATION
# ============================================================================
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
CLOUD_RUN_SERVICE_NAME=mark-foot-web

# ============================================================================
# REDIS CONFIGURATION (GCP Memorystore)
# ============================================================================
REDIS_URL=redis://10.0.0.3:6379/0

# ============================================================================
# EMAIL CONFIGURATION (SendGrid/GCP)
# ============================================================================
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.xxx
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@markfoot.com

# ============================================================================
# PAYMENT GATEWAYS
# ============================================================================
# Stripe
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PagSeguro
PAGSEGURO_TOKEN=your-pagseguro-production-token
PAGSEGURO_EMAIL=your-pagseguro-email@domain.com
PAGSEGURO_SANDBOX=False

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MERCADO_PAGO_PUBLIC_KEY=APP_USR-...

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
LOG_LEVEL=INFO

# Google Cloud Logging
GOOGLE_CLOUD_LOGGING=True

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ALLOWED_ORIGINS=https://app.markfoot.com,https://www.markfoot.com

# ============================================================================
# CELERY CONFIGURATION
# ============================================================================
CELERY_BROKER_URL=redis://10.0.0.3:6379/1
CELERY_RESULT_BACKEND=redis://10.0.0.3:6379/1

# ============================================================================
# GCP SPECIFIC SERVICES
# ============================================================================
# Cloud Pub/Sub (for background tasks)
PUBSUB_TOPIC_NAME=mark-foot-tasks
PUBSUB_SUBSCRIPTION_NAME=mark-foot-tasks-sub

# Cloud CDN
CDN_DOMAIN=cdn.markfoot.com

# Load Balancer
LB_IP_ADDRESS=35.xxx.xxx.xxx

# Auto Scaling
MIN_INSTANCES=1
MAX_INSTANCES=10

# Cloud Build
CLOUD_BUILD_TRIGGER_ID=your-trigger-id
