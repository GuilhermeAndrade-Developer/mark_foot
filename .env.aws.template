# ============================================================================
# MARK FOOT - AWS DEPLOYMENT CONFIGURATION
# ============================================================================
# Environment variables for AWS deployment
# Copy this to .env.prod and configure your AWS resources

# ============================================================================
# BASIC APPLICATION SETTINGS
# ============================================================================
DEBUG=False
DJANGO_SETTINGS_MODULE=mark_foot_backend.settings
SECRET_KEY=your-super-secret-production-key-here-min-50-chars

# ============================================================================
# FRONTEND/BACKEND URLS
# ============================================================================
FRONTEND_URL=https://app.markfoot.com
BACKEND_URL=https://api.markfoot.com
ALLOWED_HOSTS=api.markfoot.com,app.markfoot.com,*.amazonaws.com

# ============================================================================
# AWS RDS DATABASE CONFIGURATION
# ============================================================================
DB_HOST=mark-foot-prod.cluster-xxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=mark_foot_prod
DB_USER=mark_foot_admin
DB_PASSWORD=your-secure-db-password

# ============================================================================
# AWS S3 STORAGE CONFIGURATION
# ============================================================================
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_STORAGE_BUCKET_NAME=mark-foot-media-prod
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=cdn.markfoot.com
AWS_DEFAULT_ACL=public-read

# ============================================================================
# AWS ECS/ECR CONFIGURATION
# ============================================================================
AWS_REGION=us-east-1
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
ECS_CLUSTER=mark-foot-cluster
SUBNET_IDS=subnet-xxx,subnet-yyy

# ============================================================================
# REDIS CONFIGURATION (AWS ElastiCache)
# ============================================================================
REDIS_URL=redis://mark-foot-redis.xxx.cache.amazonaws.com:6379/0

# ============================================================================
# EMAIL CONFIGURATION (AWS SES)
# ============================================================================
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=AKIA...
EMAIL_HOST_PASSWORD=...
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@markfoot.com

# ============================================================================
# PAYMENT GATEWAYS
# ============================================================================
# Stripe
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PagSeguro
PAGSEGURO_TOKEN=your-pagseguro-production-token
PAGSEGURO_EMAIL=your-pagseguro-email@domain.com
PAGSEGURO_SANDBOX=False

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MERCADO_PAGO_PUBLIC_KEY=APP_USR-...

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
LOG_LEVEL=INFO

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ALLOWED_ORIGINS=https://app.markfoot.com,https://www.markfoot.com

# ============================================================================
# CELERY CONFIGURATION
# ============================================================================
CELERY_BROKER_URL=redis://mark-foot-redis.xxx.cache.amazonaws.com:6379/1
CELERY_RESULT_BACKEND=redis://mark-foot-redis.xxx.cache.amazonaws.com:6379/1

# ============================================================================
# ADDITIONAL AWS SERVICES
# ============================================================================
# CloudWatch Logs
AWS_LOGS_GROUP=mark-foot-app-logs
AWS_LOGS_STREAM=web-service

# Application Load Balancer
ALB_DNS_NAME=mark-foot-alb-xxx.us-east-1.elb.amazonaws.com

# Auto Scaling
MIN_CAPACITY=2
MAX_CAPACITY=10
DESIRED_CAPACITY=2
