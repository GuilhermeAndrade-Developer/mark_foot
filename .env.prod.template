# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# ⚠️  IMPORTANT: Replace all placeholder values with real production values
# ⚠️  NEVER commit this file with real production secrets to version control

# Environment
ENVIRONMENT=production
DEBUG=False

# Security
SECRET_KEY=your_super_long_production_secret_key_minimum_50_characters_here
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# Database Configuration (AWS RDS / GCP Cloud SQL)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
# DB_HOST=your-cloudsql-ip  # For GCP
DB_PORT=3306
DB_NAME=mark_foot_prod
DB_USER=mark_foot_prod_user
DB_PASSWORD=your_super_secure_database_password

# Redis Configuration (AWS ElastiCache / GCP Memorystore)
REDIS_URL=redis://your-redis-cluster.cache.amazonaws.com:6379/0
# REDIS_URL=redis://your-memorystore-ip:6379/0  # For GCP

# URLs (Your actual domain)
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# ============================================================================
# PAYMENT GATEWAY CONFIGURATION - PRODUCTION
# ============================================================================

# Stripe Production Keys
STRIPE_PUBLISHABLE_KEY=pk_live_your_real_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_real_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_real_webhook_secret

# PagSeguro Production
PAGSEGURO_EMAIL=your-production@email.com
PAGSEGURO_TOKEN=your_real_pagseguro_production_token
PAGSEGURO_SANDBOX=False

# Mercado Pago Production
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your_real_mercadopago_token
MERCADOPAGO_SANDBOX=False

# ============================================================================
# EXTERNAL APIs
# ============================================================================

# Football Data API
FOOTBALL_DATA_API_KEY=your_real_football_data_api_key
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_RATE_LIMIT=10

# ============================================================================
# CLOUD PROVIDER SPECIFIC
# ============================================================================

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=mark-foot-storage-prod
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=cdn.yourdomain.com

# GCP Configuration (Alternative)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GS_BUCKET_NAME=mark-foot-storage-prod
# GS_PROJECT_ID=your-gcp-project-id

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# SMTP Configuration (AWS SES / GCP Email)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_ses_smtp_username
EMAIL_HOST_PASSWORD=your_ses_smtp_password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Sentry for Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Log Level
LOG_LEVEL=WARNING

# ============================================================================
# SSL/HTTPS Configuration
# ============================================================================

# Force HTTPS in production
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ============================================================================
# PERFORMANCE & CACHING
# ============================================================================

# Static Files (CDN)
USE_CDN=True
STATIC_URL=https://cdn.yourdomain.com/static/
MEDIA_URL=https://cdn.yourdomain.com/media/

# Cache Configuration
CACHE_TTL=300
